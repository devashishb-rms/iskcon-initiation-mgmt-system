# Copy to .env and edit. Never commit .env.
NODE_ENV=development
PORT=4000
POSTGRES_PASSWORD=iskcon
DATABASE_URL=postgresql://iskcon:iskcon@localhost:5432/iskcon
RUN_MIGRATIONS_ON_BOOT=true

# 32 random bytes, base64:   openssl rand -base64 32     (rotating it signs everyone out and invalidates enrolled second factors)
APP_ENCRYPTION_KEY=

DEFAULT_TENANT_SLUG=newtown
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# 'console' prints messages to the log; 'live' sends real mail (SMTP_URL) and SMS (SMS_WEBHOOK_URL).
DELIVERY_MODE=console
# SMTP_URL=smtp://user:pass@smtp.example.org:587
# SMS_WEBHOOK_URL=https://sms.example.org/send

# Documents: 'local' for development, 's3' for anything real (see docker-compose.yml for MinIO).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=iskcon-documents
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
