# Settings for compose.prod.yml. Copy to .env on the server, fill in, chmod 600. Never commit .env.
# Public host name. Without a domain, <ip-with-dashes>.sslip.io works (e.g. 16-113-106-75.sslip.io).
SITE_HOST=
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
# openssl rand -hex 24
POSTGRES_PASSWORD=
RUN_MIGRATIONS_ON_BOOT=true
# openssl rand -base64 32   (keep a copy in your secret manager; changing it signs everyone out)
APP_ENCRYPTION_KEY=
DEFAULT_TENANT_SLUG=newtown
# https://<SITE_HOST>
PUBLIC_WEB_URL=
CORS_ORIGIN=
COOKIE_SECURE=true

# 'console' prints sign-in codes to the API log (demo only); 'live' sends mail through SMTP_URL.
DELIVERY_MODE=console
# SMTP_URL=smtp://user:pass@smtp.example.org:587
# MAIL_FROM=Initiation Office <no-reply@example.org>

# Documents on the 'documents' volume. For S3 instead: STORAGE_DRIVER=s3, S3_BUCKET, S3_REGION (and keys, or an instance role).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/documents
